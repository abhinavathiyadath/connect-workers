# Copy to backend/.env and adjust values

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/village_workers

# Secret for JWT signing — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Backend port
PORT=8888

# Allowed browser origin for CORS (React dev server)
CLIENT_ORIGIN=http://localhost:3000
